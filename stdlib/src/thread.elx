/// A recoverable operating-system thread creation failure.
pub enum SpawnError:
    Unavailable

// `Thread`, `ScopedThread`, `Scope`, `spawn`, and `scope` require native
// representation and lowering hooks and are installed from the reviewed
// intrinsic catalog. On the owned revision, unscoped closures/results are
// `Send` and borrow-free; scoped children may reborrow only until scope exit.
