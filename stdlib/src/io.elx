/// A portable category of input/output failure.
pub enum IoError:
    NotFound
    PermissionDenied
    AlreadyExists
    InvalidInput
    IsDirectory
    NotDirectory
    DirectoryNotEmpty
    ReadOnly
    BrokenPipe
    Interrupted
    WouldBlock
    TimedOut
    StorageFull
    ResourceExhausted
    Unsupported
    Other
