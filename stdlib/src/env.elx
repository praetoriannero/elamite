use std.fs
use std.io

/// Returns an owned snapshot of the process arguments, including argv[0] when
/// the host supplies it. No result borrows driver or C-runtime storage.
/// Invalid host UTF-8 bytes are replaced individually with U+FFFD.
pub fn args() -> Vec[String]:
    pass

/// Copies one environment value. `None` means that the name is not present;
/// malformed names and non-text host values are reported explicitly.
pub fn get(name: str) -> Result[Option[String], EnvError]:
    pass

/// Returns the current working directory as an owned path.
pub fn current_dir() -> Result[fs.Path, io.IoError]:
    pass

/// Portable failures from reading the process environment.
pub enum EnvError:
    InvalidName
    InvalidText
