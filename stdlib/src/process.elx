use std.fs

/// Portable failures that occur before a child exit status is available.
pub enum ProcessError:
    NotFound
    PermissionDenied
    InvalidInput
    Unavailable
    Other

/// A completed child's status. `code` is `None` when the child was terminated
/// without a portable numeric exit code.
pub struct ExitStatus:
    pub code: Option[i32]
    pub success: bool

/// Captured child output. Both streams are byte vectors because child output
/// is not required to be valid UTF-8.
pub struct Output:
    pub status: ExitStatus
    pub stdout: Vec[u8]
    pub stderr: Vec[u8]

/// Runs `program` to completion with an owned snapshot of `arguments` and
/// captures both output streams. It neither invokes a shell nor mutates the
/// parent environment. A nonzero child exit is a successful `Output` value.
/// Native temporary streams prevent either captured stream from blocking the
/// other before the child exits.
pub fn run(program: &fs.Path, arguments: [str]) -> Result[Output, ProcessError]:
    pass

/// Terminates the current process with `code`; deferred cleanup is not run.
pub fn exit(code: i32) -> !:
    pass
