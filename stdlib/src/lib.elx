/// A value that may be present or absent.
pub enum Option[T]:
    Some(T)
    None

/// A successful value or a recoverable error.
pub enum Result[T, E]:
    Ok(T)
    Err(E)

/// The failure returned by checked numeric conversion.
pub enum NumericError:
    OutOfRange
    NotANumber

/// A safe callable with one exact tuple of arguments and one exact result.
pub trait Callable[Arguments, Return]:
    fn call(self: &Self, arguments: Arguments) -> Return

/// Marker capability for values that can be independently copied to another thread.
pub trait Transfer:
    pass

/// Terminates the process with an unrecoverable diagnostic.
pub fn panic(message: str) -> !:
    pass

/// Raises an unrecoverable typed runtime trap.
pub fn trap[T: testing.RuntimeTrap](reason: T) -> !:
    pass

/// Formats a value into a standard formatter.
pub trait Display:
    fn fmt(self: &Self, formatter: &var Formatter) -> ()
