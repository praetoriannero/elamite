// elx.lark
//
// A Rust-shaped grammar for Elx. Generic arguments use square brackets and
// qualified names use periods; the Rust :: path operator is not supported. It
// intentionally omits Rust lifetimes:
// no lifetime parameters, lifetime bounds, labels, or '&' lifetime references.
// Character literals remain supported.
//
// Scope: syntax only. Name resolution, trait coherence, type checking,
// borrow checking, macro expansion, and contextual validity are not grammar
// concerns.
//
// Parse this grammar with Lark's Earley parser and dynamic lexer, for example:
// Lark.open("elx.lark", parser="earley", lexer="dynamic"). Rust permits an
// expression before a block in constructs such as `for x in value { ... }`,
// which is syntactically ambiguous with a struct expression (`value { ... }`)
// until contextual analysis resolves it.

start: crate

crate: inner_attribute* item*

// ---------------------------------------------------------------------------
// Attributes and visibility
// ---------------------------------------------------------------------------

inner_attribute: "#!" "[" meta_item "]"
outer_attribute: "#" "[" meta_item "]"

meta_item: path
         | path "=" meta_value
         | path "(" [meta_item ("," meta_item)* ","?] ")"

?meta_value: literal
           | path

visibility: "pub"
          | "pub" "(" "crate" ")"
          | "pub" "(" "self" ")"
          | "pub" "(" "super" ")"
          | "pub" "(" IN path ")"

// ---------------------------------------------------------------------------
// Items
// ---------------------------------------------------------------------------

?item: outer_attribute* item_core

?item_core: use_item
          | module_item
          | extern_crate_item
          | function_item
          | struct_item
          | union_item
          | enum_item
          | trait_item
          | impl_item
          | type_alias_item
          | const_item
          | static_item
          | extern_block
          | macro_rules_item

use_item: visibility? "use" use_tree ";"
?use_tree: path ("as" (IDENT | "_"))?
         | path "." "*"
         | path "." "{" use_tree_list? "}"
use_tree_list: use_tree ("," use_tree)* ","?

module_item: visibility? "mod" IDENT (";" | "{" inner_attribute* item* "}")
extern_crate_item: "extern" "crate" IDENT ("as" IDENT)? ";"

function_item: visibility? function_qualifier* "fn" IDENT generic_params? "(" function_params? ")" return_type? where_clause? block
function_qualifier: "const" | ASYNC | UNSAFE | extern_abi
extern_abi: "extern" STRING?
function_params: self_param ("," parameter)* ","?
               | parameter ("," parameter)* ","?
self_param: "&" MUT? "self"
          | MUT? "self"
          | "self" ":" type
parameter: MUT? pattern ":" type
return_type: "->" type

struct_item: visibility? "struct" IDENT generic_params? where_clause? (";" | tuple_fields where_clause? ";" | named_fields)
named_fields: "{" struct_field ("," struct_field)* ","? "}"
tuple_fields: "(" tuple_field ("," tuple_field)* ","? ")"
tuple_field: outer_attribute* visibility? type
struct_field: outer_attribute* visibility? IDENT ":" type

union_item: visibility? "union" IDENT generic_params? where_clause? named_fields

enum_item: visibility? "enum" IDENT generic_params? where_clause? "{" enum_variant ("," enum_variant)* ","? "}"
enum_variant: outer_attribute* IDENT (tuple_fields | named_fields)? ("=" const_expr)?

trait_item: visibility? UNSAFE? "trait" IDENT generic_params? trait_bounds? where_clause? "{" inner_attribute* trait_member* "}"
trait_bounds: ":" type_bounds
?trait_member: outer_attribute* trait_function
             | outer_attribute* trait_type
             | outer_attribute* trait_const
trait_function: function_qualifier* "fn" IDENT generic_params? "(" function_params? ")" return_type? where_clause? (";" | block)
trait_type: "type" IDENT type_bounds? where_clause? ("=" type)? ";"
trait_const: "const" IDENT ":" type ("=" const_expr)? ";"

impl_item: UNSAFE? "impl" generic_params? (type FOR)? type where_clause? "{" inner_attribute* impl_member* "}"
?impl_member: outer_attribute* function_item
            | outer_attribute* type_alias_item
            | outer_attribute* const_item

type_alias_item: visibility? "type" IDENT generic_params? where_clause? ("=" type)? ";"
const_item: visibility? "const" IDENT ":" type "=" const_expr ";"
static_item: visibility? "static" MUT? IDENT ":" type "=" const_expr ";"

extern_block: UNSAFE? extern_abi "{" inner_attribute* external_item* "}"
?external_item: visibility? "static" MUT? IDENT ":" type ";"
              | visibility? function_qualifier* "fn" IDENT generic_params? "(" function_params? ")" return_type? where_clause? ";"

macro_rules_item: "macro_rules" "!" IDENT token_tree

// ---------------------------------------------------------------------------
// Generics and types (intentionally no lifetime syntax)
// ---------------------------------------------------------------------------

generic_params: "[" generic_param ("," generic_param)* ","? "]"
?generic_param: outer_attribute* IDENT type_bounds? ("=" type)?
              | outer_attribute* "const" IDENT ":" type ("=" const_expr)?
type_bounds: ":" type_bound ("+" type_bound)* "+"?
?type_bound: "?"? path
where_clause: "where" where_predicate ("," where_predicate)* ","?
where_predicate: type ":" type_bounds
               | IDENT ":" type_bounds

?type: type_no_bounds
     | "impl" type_bounds
     | "dyn" type_bounds
?type_no_bounds: path
               | "&" MUT? type
               | "*" "const" type
               | "*" MUT type
               | "[" type ";" const_expr "]"
               | "[" type "]"
               | "(" [type ("," type)* ","?] ")"
               | "fn" "(" type_list? ")" return_type?
               | "!"           -> never_type
               | "_"           -> inferred_type
type_list: type ("," type)* ","?

path: path_segment ("." path_segment)*
path_segment: ("crate" | "self" | "super" | IDENT) generic_args?
generic_args: "[" generic_arg ("," generic_arg)* ","? "]"
generic_arg: type

// ---------------------------------------------------------------------------
// Patterns
// ---------------------------------------------------------------------------

?pattern: pattern "|" pattern_atom  -> or_pattern
        | pattern_atom
?pattern_atom: "_"                                  -> wildcard_pattern
             | identifier_pattern
             | literal                               -> literal_pattern
             | "-" INTEGER                           -> negative_integer_pattern
             | "&" MUT? pattern_atom                 -> reference_pattern
             | "(" [pattern ("," pattern)* ","?] ")" -> tuple_pattern
             | "[" [pattern ("," pattern)* ","?] "]" -> slice_pattern
             | pattern_path "(" [pattern ("," pattern)* ","?] ")" -> tuple_struct_pattern
             | pattern_path "{" field_pattern_list? "}"           -> struct_pattern
             | pattern_path (".." | "..=") pattern_path  -> path_range_pattern
             | literal (".." | "..=") literal        -> literal_range_pattern
             | pattern_path                           -> path_pattern
identifier_pattern: IDENT ("@" pattern)?
pattern_path: IDENT "." IDENT ("." IDENT)*
field_pattern_list: field_pattern ("," field_pattern)* ","?
field_pattern: outer_attribute* (IDENT (":" pattern)? | INTEGER ":" pattern) | ".."

// ---------------------------------------------------------------------------
// Statements, blocks, and expressions
// ---------------------------------------------------------------------------

block: "{" inner_attribute* block_statement* expression? "}"
?block_statement: let_statement
                | item
                | expression ";"

let_statement: "let" MUT? pattern (":" type)? ("=" expression let_else?)? ";"
let_else: ELSE block

?expression: assignment_expr

?assignment_expr: postfix_expr assign_operator assignment_expr -> assignment
                | range_expr
assign_operator: "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^="
               | "<<=" | ">>="

?range_expr: logical_or_expr ((".." | "..=") logical_or_expr?)?
           | (".." | "..=") logical_or_expr

?logical_or_expr: logical_or_expr "||" logical_and_expr -> logical_or
                | logical_and_expr
?logical_and_expr: logical_and_expr "&&" bit_or_expr -> logical_and
                 | bit_or_expr
?bit_or_expr: bit_or_expr "|" bit_xor_expr -> bit_or
            | bit_xor_expr
?bit_xor_expr: bit_xor_expr "^" bit_and_expr -> bit_xor
             | bit_and_expr
?bit_and_expr: bit_and_expr "&" equality_expr -> bit_and
             | equality_expr
?equality_expr: equality_expr ("==" | "!=") comparison_expr -> equality
              | comparison_expr
?comparison_expr: comparison_expr ("<" | "<=" | ">" | ">=") shift_expr -> comparison
                | shift_expr
?shift_expr: shift_expr ("<<" | ">>") additive_expr -> shift
           | additive_expr
?additive_expr: additive_expr ("+" | "-") multiplicative_expr -> additive
              | multiplicative_expr
?multiplicative_expr: multiplicative_expr ("*" | "/" | "%") cast_expr -> multiplicative
                   | cast_expr
?cast_expr: unary_expr ("as" type)* -> cast
?unary_expr: ("-" | "!" | "*" | "&" MUT? | "&&") unary_expr -> unary
           | postfix_expr

?postfix_expr: primary_expr postfix_suffix*
?postfix_suffix: "(" call_arguments? ")"                    -> call_suffix
               | "[" expression "]"                         -> index_suffix
               | "." (IDENT | INTEGER)                       -> field_suffix
               | "." IDENT "(" call_arguments? ")"           -> method_call_suffix
               | "?"                                        -> try_suffix
               | "." AWAIT                                    -> await_suffix
call_arguments: expression ("," expression)* ","?

?primary_expr: literal
             | value_path
             | value_path "{" struct_expression_fields? "}" -> struct_expression
             | "(" ")"                                      -> unit_expression
             | "(" expression ("," expression)+ ","? ")"    -> tuple_expression
             | "(" expression ")"                           -> grouped_expression
             | "[" [array_elements] "]"                     -> array_expression
             | "[" expression ";" expression "]"            -> repeated_array_expression
             | block
             | if_expression
             | match_expression
             | loop_expression
             | while_expression
             | for_expression
             | closure_expression
             | RETURN expression?                            -> return_expression
             | BREAK expression?                             -> break_expression
             | CONTINUE                                      -> continue_expression
             | UNSAFE block                                  -> unsafe_block_expression
             | ASYNC MOVE? block                             -> async_block_expression
             | macro_invocation
array_elements: expression ("," expression)* ","?
struct_expression_fields: struct_expression_field ("," struct_expression_field)* ","?
struct_expression_field: IDENT (":" expression)? | ".." expression

if_expression: IF expression block (ELSE (if_expression | block))?
match_expression: MATCH expression "{" match_arm ("," match_arm)* ","? "}"
match_arm: outer_attribute* pattern (IF expression)? "=>" expression
loop_expression: LOOP block
while_expression: WHILE expression block
for_expression: FOR MUT? pattern IN expression block
closure_expression: MOVE? "|" closure_parameters? "|" expression
closure_parameters: closure_parameter ("," closure_parameter)* ","?
closure_parameter: MUT? pattern (":" type)?
const_expr: expression

// ---------------------------------------------------------------------------
// Macro invocations and token trees
// ---------------------------------------------------------------------------

macro_invocation: path "!" token_tree
?token_tree: "(" macro_token* ")"
           | "[" macro_token* "]"
           | "{" macro_token* "}"
?macro_token: IDENT
            | literal
            | token_tree
            | "," | ":" | ";" | "=" | "=>" | "->"
            | "." | ".." | "..=" | "<<" | ">>" | "<<=" | ">>="
            | "==" | "!=" | "<=" | ">=" | "&&" | "||"
            | MACRO_PUNCT

// ---------------------------------------------------------------------------
// Paths and literals
// ---------------------------------------------------------------------------

value_path: path

?literal: INTEGER
        | FLOAT
        | CHAR
        | BYTE
        | STRING
        | BYTE_STRING
        | RAW_STRING
        | RAW_BYTE_STRING
        | "true"
        | "false"

// Apostrophes occur only in CHAR and BYTE. Lifetime syntax is intentionally
// absent, so text such as &'a T and fn f<'a>() is rejected.
MUT.10: "mut"
IF.10: "if"
ELSE.10: "else"
MATCH.10: "match"
LOOP.10: "loop"
WHILE.10: "while"
FOR.10: "for"
IN.10: "in"
RETURN.10: "return"
BREAK.10: "break"
CONTINUE.10: "continue"
UNSAFE.10: "unsafe"
ASYNC.10: "async"
MOVE.10: "move"
AWAIT.10: "await"
IDENT: /r#[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*/
INTEGER.2: /(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*)(?:[iu](?:8|16|32|64|128|size))?/
FLOAT.3: /(?:[0-9][0-9_]*\.[0-9][0-9_]*|[0-9][0-9_]*\.(?!\.)|[0-9][0-9_]*[eE][+-]?[0-9_]+)(?:f(?:32|64))?/
CHAR.4: /'(?:[^'\\\n\r]|\\(?:[nrt0\\'"]|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]+\}))'/
BYTE.4: /b'(?:[^'\\\n\r]|\\(?:[nrt0\\'"]|x[0-9a-fA-F]{2}))'/
STRING.4: /"(?:[^"\\\n\r]|\\(?:[nrt0\\'"]|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]+\}))*"/
BYTE_STRING.5: /b"(?:[^"\\\n\r]|\\(?:[nrt0\\'"]|x[0-9a-fA-F]{2}))*"/
RAW_STRING.4: /r"(?:[^"\r\n])*"/
RAW_BYTE_STRING.5: /br"(?:[^"\r\n])*"/
MACRO_PUNCT: /=>|->|\.{1,3}|<<=?|>>=?|==|!=|<=|>=|&&|\|\||[!#$%&*+\-\/<=>?@^|~:;,\.]/

LINE_COMMENT: /\/\/[^\n]*/
BLOCK_COMMENT: /\/\*(?s:.*?)\*\//

%import common.WS
%ignore WS
%ignore LINE_COMMENT
%ignore BLOCK_COMMENT
