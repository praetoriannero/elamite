// Compute pi from one billion terms of the Leibniz series:
//
//     pi = 4 * (1 - 1/3 + 1/5 - 1/7 + ...)
//
// This intentionally uses the direct, slowly converging form as a simple
// floating-point and loop-throughput benchmark.

fn leibniz_pi(iterations: u64) -> f64:
    var sum = 0.0f64
    var denominator = 1.0f64
    var sign = 1.0f64
    var iteration = 0u64

    while iteration < iterations:
        sum += sign / denominator
        denominator += 2.0f64
        sign = -sign
        iteration += 1u64

    return sum * 4.0f64

fn main():
    let iterations = 1_000_000_000u64
    let pi = leibniz_pi(iterations)
    println(f"Leibniz pi after {iterations} iterations: {pi}")
