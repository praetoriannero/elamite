// Supplemental Elamite examples for copy and explicit-reference behavior.
// This file uses the same language model as SPEC.md and spec_demo.elx.

struct Address:
    street: String
    city: String

struct User:
    name: String
    address: Address

    fn renamed(self, name: String) Self:
        User { name, address: self.address }

    fn relocate(self: &var Self, city: String):
        self.address.city = city

fn replace_city(address: &var Address, city: String):
    address.city = city

fn describe(user: &User) String:
    user.name

fn main():
    let home = Address { street: "10 Main Street", city: "Aster" }
    var office = home
    office.city = "Beacon"

    // `home` and `office` are independent copied values.
    println("home: {}", home.city)
    println("office: {}", office.city)

    var user = User { name: "Ari", address: home }
    let original_user = user
    user.relocate("Cedar")

    println("{} in {}", describe(&original_user), original_user.address.city)
    println("{} in {}", describe(&user), user.address.city)

    let user_ref: &var User = &var user
    replace_city(&var user_ref.address, "Dover")
    println("{} in {}", describe(&user), user.address.city)

    // Closures capture ordinary values by copy.
    let greeting = "hello"
    let greet: fn(String) () = |name: String| println("{}, {}", greeting, name)
    greet("Elamite")

    // Capture a reference explicitly when later mutations should be observed.
    var notices = 0
    let notices_ref: &var i32 = &var notices
    let report_notice = ||:
        *notices_ref = *notices_ref + 1
    report_notice()
    println("notices: {}", notices)
