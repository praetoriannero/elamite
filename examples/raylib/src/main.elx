// raylib's small C API is a natural fit for Elamite's explicit C boundary.
// Calls are unsafe because the foreign header and library are outside the
// guarantees checked by the Elamite compiler.

@importc("elamite_raylib_init", "elamite_raylib.h")
fn raylib_init(width: i32, height: i32) -> ()

@importc("elamite_raylib_should_close", "elamite_raylib.h")
fn raylib_should_close() -> i32

@importc("elamite_raylib_horizontal_input", "elamite_raylib.h")
fn horizontal_input() -> i32

@importc("elamite_raylib_vertical_input", "elamite_raylib.h")
fn vertical_input() -> i32

@importc("elamite_raylib_draw_instructions", "elamite_raylib.h")
fn draw_instructions() -> ()

@importc("elamite_raylib_clear_background", "elamite_raylib.h")
fn clear_background() -> ()

@importc("elamite_raylib_draw_border", "elamite_raylib.h")
fn draw_border() -> ()

@importc("elamite_raylib_draw_circle", "elamite_raylib.h")
fn draw_circle(x: f32, y: f32, radius: f32) -> ()

@importc("GetFrameTime", "raylib.h")
fn frame_time() -> f32

@importc("BeginDrawing", "raylib.h")
fn begin_drawing() -> ()

@importc("EndDrawing", "raylib.h")
fn end_drawing() -> ()

@importc("DrawFPS", "raylib.h")
fn draw_fps(x: i32, y: i32) -> ()

@importc("CloseWindow", "raylib.h")
fn close_window() -> ()

fn main():
    let screen_width: f32 = 800.0
    let screen_height: f32 = 450.0
    let radius: f32 = 28.0
    let speed: f32 = 260.0

    var x = screen_width / 2.0
    var y = screen_height / 2.0

    unsafe:
        raylib_init(screen_width as i32, screen_height as i32)

        while raylib_should_close() == 0:
            let delta = frame_time()
            let horizontal = horizontal_input() as f32
            let vertical = vertical_input() as f32

            x += horizontal * speed * delta
            y += vertical * speed * delta

            // Keep the complete circle within the window.
            if x < radius:
                x = radius
            if x > screen_width - radius:
                x = screen_width - radius
            if y < radius:
                y = radius
            if y > screen_height - radius:
                y = screen_height - radius

            begin_drawing()
            clear_background()
            draw_instructions()
            draw_fps(20, 50)
            draw_border()
            draw_circle(x, y, radius)
            end_drawing()

        close_window()
