// FINDING 5 — the `self` path root resolves in a `use` declaration but not in
// an expression path.
//
// SPEC 2.3: "Paths use periods. `root` begins at the current package root,
// `self` begins at the current module, and `super` begins at its parent."
// No rule limits `self` to import position.
//
// Expected: compiles; prints 1.
// Actual:   error: cannot resolve `self`
//
// `use self.inner.value` is accepted, and `super.name()` works in expression
// position, so only the expression-path form of `self` is affected.

fn local() -> i32:
    return 1

fn via_self() -> i32:
    return self.local()

fn main():
    println(f"{via_self()}")
