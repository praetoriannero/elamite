// REGRESSION 5 — the `self` module path root resolves in expressions.
//
// SPEC 2.3: "Paths use periods. `root` begins at the current package root,
// `self` begins at the current module, and `super` begins at its parent."
// No rule limits `self` to import position.
//
// Expected and current: compiles; prints 1.
//
fn local() -> i32:
    return 1

fn via_self() -> i32:
    return self.local()

fn main():
    println(f"{via_self()}")
