// REGRESSION 12 — statically evident invalid arithmetic is a compile error.
//
// SPEC 4.1: "A statically evident invalid literal, conversion, or arithmetic
// operation is a compile-time error." LEDGER 4.1 assigns the static-detection
// half of that row to M6 and marks the row complete.
//
// Expected and current: each line below is diagnosed at compile time.
//
// The array half of the same rule *is* implemented: a statically known
// out-of-bounds array index is correctly rejected with
// "error: this constant array index is out of bounds".
//
fn main():
    let overflow: i32 = 2147483647 + 1
    let bad_shift = 1i32 << 32u32
    let divide_by_zero = 1i32 / 0i32
    println(f"{overflow} {bad_shift} {divide_by_zero}")
