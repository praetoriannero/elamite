// REGRESSION 9 — trait-object equality compares concrete target identity.
//
// SPEC 4.5: "Safe references compare target storage identity rather than
// target contents. Trait-object references likewise compare their concrete
// target identity." LEDGER 4.5 records this row as run-pass tested.
//
// Expected and current: compiles; prints true.
//
trait Greet:
    fn greeting(self: &Self) -> str

struct Dog:
    name: str

impl Greet for Dog:
    fn greeting(self: &Self) -> str:
        return "woof"

fn main():
    let dog = Dog { name: "Rex" }
    let first: &Greet = &dog
    let second: &Greet = &dog
    println(f"{first == second}")
