// REGRESSION 11 — zero-length arrays use a portable C99 representation.
//
// SPEC 4.1: "A fixed array type is `[T; N]`, where `N` is a compile-time
// nonnegative `usize` value." Zero is nonnegative.
//
// Expected and current: compiles; prints 0.

fn main():
    let empty: [i32; 0] = []
    println(f"{empty.len()}")
