enum State:
    Value(i32)
    Empty

struct Countdown:
    current: i32

impl Iterator[i32] for Countdown:
    fn next(self: &var Self) -> Option[i32]:
        if self.current <= 0:
            return Option.None
        let value = self.current
        self.current -= 1
        return Option.Some(value)

fn main() -> ():
    var total = 0
    for value in [1, 2, 3]:
        total += value
    match State.Value(total):
        State.Value(value):
            println(value)
        State.Empty:
            println(0)

    var iterator_total = 0
    for value in Countdown { current: 3 }:
        iterator_total += value
    println(iterator_total)
