// FINDING M1 — the only function-like macro invocation syntax the
// specification defines cannot be parsed.
//
// SPEC 12.4: "A function-like macro is invoked as `@path(...)`."
//
// Expected (once execution lands): `@make(1)` parses as a macro invocation and
//           is either expanded or reported as awaiting the interpreter.
// Actual:   the parser never accepts `(` after a macro name. src/parser.rs
//           hard-codes the three compiler macros and then calls
//           `recover_macro_invocation`, which accepts only `[` or `{`:
//
//             error: unknown compiler macro `@make`; expected `@vec`, `@map`,
//                    or `@set`
//             error: expected `[` or `{` after macro name
//
// Two consequences beyond the missing feature:
//
//   1. The diagnostic is misleading *with* the macro namespace populated and the
//      macro declared, collected, and importable. It reports a declared user
//      macro as an unknown compiler macro and suggests three unrelated names.
//   2. src/expansion/gate.rs carries a `SyntaxKind::MacroExpression if
//      is_user_macro_invocation(node)` branch producing "user-defined macro
//      invocations are gated". That branch is unreachable
//      for the `(` form, because parsing fails first. Without the gate this
//      file emits the two parse errors *and* the gate error; with the gate it
//      emits only the parse errors.
//
// Path-qualified invocation (`@helpers.make(1)`) is likewise unparseable: the
// macro name is read as a single identifier, not a path.
//

macro make(value: std.ast.Expression) -> std.ast.Expression:
    let result: std.ast.Expression = quote:
        $value + 1
    return result

fn main():
    println(f"{@make(1)}")
