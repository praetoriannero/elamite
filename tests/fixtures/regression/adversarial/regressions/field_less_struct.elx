// REGRESSION 10 — fieldless structs compile under the warning-clean C backend.
//
// SPEC 2.2 makes `pass` the explicit no-op for a body that would otherwise be
// empty, and SPEC 4.2 places no lower bound on a struct's field count.
//
// Expected and current: compiles and prints "constructed".
//
struct Marker:
    pass

fn main():
    let marker = Marker {}
    println("constructed")
