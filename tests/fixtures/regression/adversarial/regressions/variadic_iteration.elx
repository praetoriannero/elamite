// REGRESSION 3 — variadic tails are immutable, iterable slices with `len` and
// managed backing storage that remains valid after the call returns.
//
// SPEC 5 binds a variadic tail to the slice type `[T]` and then shows exactly
// this body:
//
//     pub fn variadic(x: i32, y: ...String) -> ():
//         for value in y:
//             println(f"{x}: {value}")
//
// SPEC 5 and 7.1 now define this behavior explicitly.

pub fn collect(y: ...String) -> [String]:
    return y

pub fn saved_values() -> [String]:
    return collect(String.from("one"), String.from("two"))

pub fn variadic(x: i32, y: [String]) -> ():
    println(f"length: {y.len()}")
    for value in y:
        println(f"{x}: {value}")

fn main():
    variadic(7, saved_values())
