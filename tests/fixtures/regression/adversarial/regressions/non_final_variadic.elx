// REGRESSION 15 — misplaced or repeated variadic parameters are rejected by
// the parser before semantic lowering.
//
// SPEC 5: "Variadics are homogeneous and may appear only once, as the final
// parameter." LEDGER 5 records that row against M3/M6/M8 with compile-pass and
// run-pass evidence.
//
// The rejected declaration forms live in `tests/parser.rs`; this shipped
// source remains formatter-valid and witnesses the accepted final form.
//
// This is not macro-specific: the identical hole exists for compile-time
// declarations, where SPEC 12.1 restates the rule for `macro` and `attr` and
// forbids it outright for `derive`.

fn final_variadic(head: i32, rest: ...i32) -> i32:
    return head + rest[0]

fn main():
    println(f"{final_variadic(1, 2)}")
