// DESIGN DECISION 14 — named function references satisfy static `Callable`
// bounds but intentionally do not erase directly to `&Callable`.
//
// LEDGER 5 states: "named safe function references also satisfy matching
// callable APIs; `&Callable` provides erasure". A `Callable` *bound* does
// accept a named function reference:
//     fn apply[F: Callable[(i32,), i32]](callback: F, value: i32) -> i32
//     apply(increment, 41)   // works
//
// Erasing that same reference behind `&Callable` does not:
//     increment as &Callable[(i32,), i32]
//     -> error: this type does not implement trait `Callable`
//
// SPEC 5.1 now makes the rejection explicit: erasure needs referenced nominal
// storage and never converts a C function pointer into a data pointer or
// introduces an implicit allocation merely to create trait-object identity.

fn increment(value: i32) -> i32:
    return value + 1

fn apply_erased(callback: &Callable[(i32,), i32], value: i32) -> i32:
    return callback(value)

fn main():
    println(f"{apply_erased(increment as &Callable[(i32,), i32], 41)}")
