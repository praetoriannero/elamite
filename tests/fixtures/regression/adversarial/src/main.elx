// Adversarial conformance package: see README.md.
//
// A file-backed submodule is already bound in its parent module's item
// namespace (`docs/SPEC.md` 2.3), so `root` reaches each region directly. Writing
// `use root.copies` here would be a duplicate-definition error, not an import.

pub fn main() -> ():
    layout.run()
    copies.run()
    references.run()
    pointers.run()
    numerics.run()
    aggregates.run()
    collections.run()
    functions.run()
    closures.run()
    generics.run()
    traits.run()
    control.run()
    concat.run()
    text.run()
    errors.run()
