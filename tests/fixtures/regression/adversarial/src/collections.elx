/// # Collections and iteration (`docs/spec.md` 4.1, 7.1)
///
/// Map and set iteration order is unspecified, so every observation here is
/// order-independent.

struct Item(PartialEq, Eq, Hash):
    id: i32
    tag: str

/// Vector boundaries: insertion is valid through `len` inclusive, removal
/// only below `len`, and a value-context read copies.
fn vector_boundaries() -> ():
    var values: Vec[i32] = Vec.new()
    println(f"new vector: {values.len()} {values.is_empty()}")

    values.append(2)
    values.insert(0, 1)
    values.insert(values.len(), 3)
    println(f"after inserts: {values[0]} {values[1]} {values[2]} len {values.len()}")

    let removed = values.remove(0)
    println(f"removed head: {removed}, new head: {values[0]}, len: {values.len()}")

    // A value-context read is a shallow copy; this scalar is inline.
    var copied = values[0]
    copied += 100
    println(f"read is a copy: {copied} vs {values[0]}")

    // An index through a mutable path is an assignable place.
    values[0] = 20
    values[0] += 5
    println(f"indexed assignment: {values[0]}")

    match values.get(values.len()):
        Option.Some(value):
            println(f"unexpected get past end: {value}")
        Option.None:
            println("get past end: None")

    values.clear()
    println(f"cleared: {values.len()} {values.is_empty()}")

/// Nested collection reads preserve their backing identities.
fn nested_collections() -> ():
    var grid = @vec[@vec[1, 2], @vec[3, 4]]
    let snapshot = grid

    grid[0][0] = 99
    grid[1].append(5)

    println(f"mutated grid: {grid[0][0]} {grid[1].len()}")
    println(f"snapshot aliases backing: {snapshot[0][0]} {snapshot[1].len()}")

    var by_name: Map[str, Vec[i32]] = Map.new()
    by_name.insert("primes", @vec[2, 3, 5])
    var extracted = by_name["primes"]
    extracted.append(7)
    let stored = by_name["primes"]
    println(
        f"map value read can diverge on growth: {extracted.len()} vs {stored.len()}"
    )

/// Map insert and remove report the displaced value, and a duplicate literal
/// key keeps the last entry.
fn map_boundaries() -> ():
    var scores = @map{ "ada": 1, "grace": 2, "ada": 3 }
    let ada = scores["ada"]
    println(f"duplicate literal key collapses: {scores.len()} value {ada}")

    match scores.insert("ada", 4):
        Option.Some(previous):
            println(f"insert replaced: {previous}")
        Option.None:
            println("insert added a new key")

    match scores.insert("linus", 5):
        Option.Some(previous):
            println(f"unexpected replacement: {previous}")
        Option.None:
            println("insert added a new key")

    match scores.remove("missing"):
        Option.Some(value):
            println(f"unexpected removal: {value}")
        Option.None:
            println("remove of an absent key: None")

    match scores.remove("linus"):
        Option.Some(value):
            println(f"removed: {value}")
        Option.None:
            println("unexpected absent key")

    let has_ada = scores.contains_key("ada")
    let has_linus = scores.contains_key("linus")
    println(f"contains: {has_ada} {has_linus}")

    // An indexed mutable place requires an existing key.
    scores["ada"] = 10
    scores["ada"] += 1
    let updated = scores["ada"]
    println(f"indexed map assignment: {updated}")

    match scores.get("ada"):
        Option.Some(value):
            println(f"get present: {value}")
        Option.None:
            println("unexpected absent key")

/// Set insert and remove report membership transitions rather than values.
fn set_boundaries() -> ():
    var tags = @set{ "alpha", "beta", "alpha" }
    println(f"duplicate literal element collapses: {tags.len()}")

    let added = tags.insert("gamma")
    let added_again = tags.insert("gamma")
    let dropped = tags.remove("gamma")
    let dropped_again = tags.remove("gamma")
    let has_alpha = tags.contains("alpha")
    let has_gamma = tags.contains("gamma")
    println(f"insert new then existing: {added} {added_again}")
    println(f"remove present then absent: {dropped} {dropped_again}")
    println(f"contains: {has_alpha} {has_gamma}")

/// A struct key qualifies for `StableHash` when every hashed field does.
fn structural_keys() -> ():
    var seen: Set[Item] = Set.new()
    let first = seen.insert(Item { id: 1, tag: "a" })
    let repeat = seen.insert(Item { id: 1, tag: "a" })
    let distinct = seen.insert(Item { id: 2, tag: "a" })
    println(f"struct keys: {first} {repeat} {distinct}")

    // A tuple of stable components is itself stable.
    var pairs: Map[(i32, str), i32] = Map.new()
    pairs.insert((1, "x"), 10)
    pairs.insert((1, "y"), 20)
    let looked_up = pairs[(1, "x")]
    println(f"tuple keys: {pairs.len()} {looked_up}")

/// Arrays are fixed-size inline aggregates with shallow element-slot copies.
fn array_boundaries() -> ():
    var values = [1, 2, 3]
    let snapshot = values
    values[0] = 99

    println(f"array copy independence: {values[0]} vs {snapshot[0]}")
    println(f"array length is fixed: {values.len()}")

    match values.get(2):
        Option.Some(value):
            println(f"array get in range: {value}")
        Option.None:
            println("unexpected out of range")

    match values.get(3):
        Option.Some(value):
            println(f"unexpected in range: {value}")
        Option.None:
            println("array get out of range: None")

    // A two-dimensional array copies at every level.
    var grid = [[1, 2], [3, 4]]
    let grid_snapshot = grid
    grid[1][1] = 40
    println(f"nested array: {grid[1][1]} vs {grid_snapshot[1][1]}")

    // A zero-length `[T; 0]` array is specified but does not survive C
    // emission; see regressions/zero_length_array.elx.

/// The iterable is evaluated once and shallow-copied into hidden loop state.
/// Element replacement remains visible; structural mutation is undefined and
/// is deliberately not executed here.
fn iteration_uses_shallow_hidden_state() -> ():
    var values = @vec[1, 2, 3]
    var visited = 0
    var total = 0

    for value in values:
        visited += 1
        total += value
        if visited == 1:
            values[1] = 20

    println(f"loop visited: {visited}, total: {total}")
    println(f"source length stayed: {values.len()}")

    // Array and vector iteration is in index order.
    var order = String.from("")
    for value in [3, 1, 2]:
        order = concatenate(order, value)
    println(f"array iteration order: {order}")

fn concatenate(text: String, value: i32) -> String:
    return String.from(f"{text}{value}")

/// Map and set iteration order is unspecified, so only order-independent
/// aggregates are observed.
fn unordered_iteration() -> ():
    let scores = @map{ "a": 1, "b": 2, "c": 3 }
    var key_count = 0
    var value_total = 0
    for entry in scores:
        key_count += 1
        value_total += entry.1
    println(f"map iteration: {key_count} entries, total {value_total}")

    let numbers = @set{ 10, 20, 30 }
    var element_total = 0
    for value in numbers:
        element_total += value
    println(f"set iteration total: {element_total}")

    // An empty collection yields no iterations.
    let empty: Vec[i32] = Vec.new()
    var empty_visits = 0
    for value in empty:
        empty_visits += 1
    println(f"empty iteration visits: {empty_visits}")

pub fn run() -> ():
    println("== 4.1/7.1 collections ==")
    vector_boundaries()
    nested_collections()
    map_boundaries()
    set_boundaries()
    structural_keys()
    array_boundaries()
    iteration_uses_shallow_hidden_state()
    unordered_iteration()
