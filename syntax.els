struct Vec<T> {
    item: T,
}


struct Example {
    a: i32,
    b: string,
    c: vec<f64>,
}

struct Beta {
    xi: i32,
}

struct Alpha: Beta {
    phi: u64,
}

let lambda = | x: &u64 | -> string {
    return format("{}", x);
}

union TestUnion {
    i32,
    string,
    vec<string>,
}

default Example {
    a: 0,
    b: "",
    c: Vec<f64>::default(),
}

impl Example {
    fn new() -> Self {
        return Example{a: 10, b: "test"};
    }

    fn foo(a: Example) -> &mut f32 {
        let _x: f32 = 0.0;
        let mut y = _x.pow(2);
        return &y;
    }
}

